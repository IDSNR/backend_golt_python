# Local development database connection. Copy this file to .env and replace values.
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/golt

# Create missing SQLAlchemy tables automatically when the API starts.
# Keep false when using migration tooling in shared environments.
DB_AUTO_CREATE=false
PERSISTENCE_ENABLED=true

PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
MEDIA_FOLDER=media_files
MEDIA_URL_PATH=/media/files
MAX_MEDIA_UPLOAD_BYTES=209715200

# Use "local" for development. Use "s3" after provisioning an S3-compatible
# object store and a CDN with private origin access.
MEDIA_STORAGE_BACKEND=local
MEDIA_CDN_BASE_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
ADMIN_USER_IDS=user-1
